@using Aula09.Web.Models

<div class="card mt-4">
    <div class="card-header">
        <h4>Detalhes do Produto</h4>
    </div>
    <div class="card-body">
        @if (ProdutoSelecionado == null)
        {
            <p class="text-muted">Selecione um produto para ver os detalhes.</p>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6>Nome</h6>
                    <p>@ProdutoSelecionado.Nome</p>
                </div>
                <div class="col-md-6">
                    <h6>Preço</h6>
                    <p>@ProdutoSelecionado.Preco.ToString("C")</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <h6>Categoria</h6>
                    <p>@ProdutoSelecionado.Categoria?.Nome</p>
                </div>
                <div class="col-md-6">
                    <h6>Status</h6>
                    <p>
                        @if (ProdutoSelecionado.Ativo)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inativo</span>
                        }
                    </p>
                </div>
            </div>

            <div class="mb-3">
                <h6>ID</h6>
                <p>@ProdutoSelecionado.Id</p>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    public Produto? ProdutoSelecionado { get; set; }
}
