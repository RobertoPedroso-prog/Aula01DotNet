@page "/configuracoes"
@using Aula09.Web.Services
@inject TemaService TemaService

<h1>Configurações</h1>

<div class="card mt-4">
    <div class="card-header">
        <h5>Aparência</h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Tema</label>
            <div class="btn-group" role="group">
                <button type="button"
                        class="btn @(Tema == "light" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => TemaService.AlterarTemaAsync("light")'>
                    ☀️ Claro
                </button>
                <button type="button"
                        class="btn @(Tema == "dark" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => TemaService.AlterarTemaAsync("dark")'>
                    🌙 Escuro
                </button>
            </div>
        </div>
        <p class="text-muted">Tema atual: <strong>@(Tema == "light" ? "Claro" : "Escuro")</strong></p>
    </div>
</div>

@code {
    // Recebido do MainLayout via CascadingValue: reflete o tema sem a página assinar eventos
    [CascadingParameter(Name = "Tema")]
    public string Tema { get; set; } = "light";
}
