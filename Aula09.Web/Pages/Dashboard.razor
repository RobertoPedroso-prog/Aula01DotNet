@page "/dashboard"
@using Aula09.Web.Models
@using Aula09.Web.Services
@inject ProdutoService ProdutoService

<h1>Dashboard de Produtos</h1>

<div class="dashboard">
    <Card Titulo="Total de Produtos" Icone="bi bi-box">
        <h2>@TotalProdutos</h2>
        <p class="text-muted">Produtos cadastrados</p>
    </Card>

    <Card Titulo="Preço Médio" Icone="bi bi-tag">
        <h2>@PrecoMedio.ToString("C")</h2>
        <p class="text-muted">Valor médio dos produtos</p>
    </Card>

    <Card Titulo="Total em Estoque" Icone="bi bi-basket">
        <h2>@TotalEstoque</h2>
        <p class="text-muted">Unidades disponíveis</p>
    </Card>

    <Card Titulo="Categoria com Mais Produtos" Icone="bi bi-list-ul">
        <h2>@CategoriaComMais?.Nome</h2>
        <p class="text-muted">@CategoriaComMais?.Produtos.Count produtos</p>
    </Card>
</div>

<style>
    .dashboard {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
</style>

@code {
    private int TotalProdutos;
    private decimal PrecoMedio;
    private int TotalEstoque;
    private Categoria CategoriaComMais;
    private List<Produto> Produtos = [];

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        Produtos = await ProdutoService.ObterTodosAsync();

        TotalProdutos = Produtos.Count;
        PrecoMedio = Produtos.Any() ? Produtos.Average(p => p.Preco) : 0;
        TotalEstoque = Produtos.Sum(p => p.Estoque);

        if (Produtos.Any())
        {
            var categoriasComProdutos = Produtos
                .GroupBy(p => p.Categoria)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();

            CategoriaComMais = categoriasComProdutos?.Key;
        }
    }
}
