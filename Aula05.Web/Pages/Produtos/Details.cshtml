@page "{id:int}"
@model Aula05.Web.Pages.Produtos.DetailsModel

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<h2>Detalhes do Produto</h2>

<div class="card-surface">
    <partial name="_ProdutoResumo" model="Model.Produto" />
</div>

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Produto.Id" class="btn btn-primary">Editar</a>
    <a asp-page="Index" class="btn btn-secondary">Voltar</a>
</div>
