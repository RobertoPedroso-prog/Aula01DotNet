<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Aula07.Web</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-page="/Produtos/Index">Produtos</a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Produtos/Create">+ Novo Produto</a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </li>
            </ul>

            <div class="d-flex align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="me-3 d-flex align-items-center flex-wrap gap-1">
                        <span class="text-dark me-1" style="font-size: 0.9rem;">
                            👤 <strong>@User.Identity.Name</strong>
                        </span>

                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        @if (User.IsInRole("Gerente"))
                        {
                            <span class="badge bg-warning text-dark">Gerente</span>
                        }
                        @if (User.IsInRole("Usuario"))
                        {
                            <span class="badge bg-secondary">Usuário</span>
                        }

                        @{
                            var deptoClaim = User.Claims.FirstOrDefault(c => c.Type == "Departamento")?.Value;
                        }
                        @if (!string.IsNullOrEmpty(deptoClaim))
                        {
                            <span class="badge bg-info text-dark" title="Claim: Departamento">Depto: @deptoClaim</span>
                        }
                    </div>

                    <form class="d-inline" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sair</button>
                    </form>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Account/Login">Entrar</a>
                        <a class="btn btn-sm btn-primary" asp-page="/Account/Register">Cadastrar</a>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>
