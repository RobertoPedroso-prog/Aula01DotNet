@page "{id:int}"
@model Aula07.Web.Pages.Produtos.DeleteModel
@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Excluir Produto (Acesso Restrito: Administrador)</h4>
            </div>
            <div class="card-body">
                <p class="text-danger fw-bold">Tem certeza que deseja excluir este produto?</p>

                <partial name="_ProdutoResumo" model="Model.Produto" />

                <form method="post" class="mt-3">
                    <input type="hidden" asp-for="Produto.Id" />
                    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                    <a asp-page="Index" class="btn btn-secondary ms-2">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
