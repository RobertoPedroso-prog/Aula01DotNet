@page "{id:int}"
@model Aula07.Web.Pages.Produtos.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Detalhes do Produto</h4>
            </div>
            <div class="card-body">
                <partial name="_ProdutoResumo" model="Model.Produto" />

                <div class="mt-4">
                    @if (User.IsInRole("Admin") || User.IsInRole("Gerente"))
                    {
                        <a asp-page="Edit" asp-route-id="@Model.Produto.Id" class="btn btn-warning">Editar</a>
                    }
                    <a asp-page="Index" class="btn btn-secondary ms-2">Voltar</a>
                </div>
            </div>
        </div>
    </div>
</div>
