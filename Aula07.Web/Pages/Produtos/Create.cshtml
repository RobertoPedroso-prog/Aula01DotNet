@page
@model Aula07.Web.Pages.Produtos.CreateModel
@{
    ViewData["Title"] = "Novo Produto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Novo Produto (Acesso Restrito: Administrador)</h4>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <partial name="_ProdutoForm" for="Produto" />

                    <div class="form-group mb-3">
                        <label class="form-label">Categoria</label>
                        <select asp-for="Produto.CategoriaId"
                                asp-items="Model.Categorias"
                                class="form-select">
                            <option value="">-- Selecione uma categoria --</option>
                        </select>
                        <span asp-validation-for="Produto.CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Imagem do Produto (PNG ou JPG, máx 2MB)</label>
                        <input type="file" name="ImagemUpload" class="form-control" accept=".png,.jpg,.jpeg" />
                        <span asp-validation-for="ImagemUpload" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Salvar Produto</button>
                        <a asp-page="Index" class="btn btn-secondary ms-2">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validation-ptbr.js"></script>
}
