@page "{id:int}"
@model Aula07.Web.Pages.Produtos.EditModel
@{
    ViewData["Title"] = "Editar Produto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Editar Produto (Acesso Restrito: Administrador e Gerente)</h4>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Produto.Id" />
                    <input type="hidden" asp-for="Produto.Imagem" />
                    <partial name="_ProdutoForm" for="Produto" />

                    <div class="form-group mb-3">
                        <label class="form-label">Categoria</label>
                        <select asp-for="Produto.CategoriaId"
                                asp-items="Model.Categorias"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Produto.CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Imagem</label>
                        @if (!string.IsNullOrEmpty(Model.Produto.Imagem))
                        {
                            <div class="mb-2">
                                <img src="~/imagens/@Model.Produto.Imagem" width="120" class="rounded border" />
                            </div>
                        }
                        <input type="file" name="ImagemUpload" class="form-control" accept=".png,.jpg,.jpeg" />
                        <span asp-validation-for="ImagemUpload" class="text-danger"></span>
                        <div class="form-text">Envie um novo arquivo apenas se desejar substituir a imagem atual.</div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning">Salvar Alterações</button>
                        <a asp-page="Index" class="btn btn-secondary ms-2">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validation-ptbr.js"></script>
}
