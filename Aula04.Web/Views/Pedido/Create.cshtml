@model Aula04.Web.Models.Pedido

@{
    ViewData["Title"] = "Novo Pedido";
}

<h2>Novo Pedido</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label for="dataPedido" class="form-label">Data do Pedido</label>
        <input type="datetime-local" id="dataPedido" name="dataPedido" class="form-control"
               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"/>
    </div>

    <div class="form-group mb-3">
        <label for="produtoIds" class="form-label">Produtos</label>
        <select id="produtoIds" name="produtoIds" class="form-select" multiple size="8">
            @foreach (var produto in (List<Aula04.Web.Models.Produto>)ViewBag.Produtos)
            {
                <option value="@produto.Id">@produto.Nome (@produto.Preco.ToString("C"))</option>
            }
        </select>
        <div class="form-text">Segure Ctrl (ou Cmd) para selecionar mais de um produto.</div>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
