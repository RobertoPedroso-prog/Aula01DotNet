@page "/produtos"
@using System.Text.Json
@using Aula10.BlazorWasm.Models
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Produtos</PageTitle>

<header class="page-header">
    <h1>Produtos</h1>
    <p class="text-secondary mb-0">
        Lista e cadastro pela API (<code>/api/produtos</code>), com cache offline da última lista.
    </p>
</header>

<div class="row g-4">
    <div class="col-lg-5">
        <section class="card" aria-label="Criar produto">
            <div class="card-header">Novo produto</div>
            <div class="card-body">
                <EditForm Model="novoProduto" OnValidSubmit="CriarProduto">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" @bind-Value="novoProduto.Nome" placeholder="Ex: Mouse" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Preço (R$)</label>
                        <InputNumber class="form-control" @bind-Value="novoProduto.Preco" step="0.01" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@salvando">
                        @if (salvando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <span>Salvar</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(erroSalvar))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@erroSalvar</div>
                    }
                    @if (!string.IsNullOrEmpty(sucessoSalvar))
                    {
                        <div class="alert alert-success mt-3 mb-0" role="status">@sucessoSalvar</div>
                    }
                </EditForm>
            </div>
        </section>
    </div>

    <div class="col-lg-7">
        <section class="card" aria-label="Lista de produtos">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Lista de produtos</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CarregarProdutos" disabled="@carregandoLista">
                    Atualizar
                </button>
            </div>

            @if (carregandoLista && produtos == null)
            {
                <div class="card-body d-flex align-items-center" role="status">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Carregando produtos...</span>
                </div>
            }
            else if (produtos == null)
            {
                <div class="card-body">
                    <div class="alert alert-danger mb-0" role="alert">
                        <p class="mb-2">@erroLista</p>
                        <button class="btn btn-sm btn-danger" @onclick="CarregarProdutos">Tentar novamente</button>
                    </div>
                </div>
            }
            else
            {
                @if (offline)
                {
                    <div class="card-body pb-0">
                        <div class="alert alert-warning mb-0" role="alert">
                            Sem conexão com a API. Exibindo a última lista salva neste dispositivo
                            (@(dataCache?.ToString("dd/MM/yyyy HH:mm"))).
                            <button class="btn btn-sm btn-warning ms-2" @onclick="CarregarProdutos">Tentar novamente</button>
                        </div>
                    </div>
                }

                @if (!produtos.Any())
                {
                    <div class="card-body">
                        <div class="alert alert-info mb-0">Nenhum produto cadastrado.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive @(offline ? "mt-3" : null)">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th class="text-end">Preço</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in produtos)
                                {
                                    <tr>
                                        <td>@p.Nome</td>
                                        <td class="text-end">@p.Preco.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    private const string ChaveCache = "aula10.produtos";

    private List<ProdutoDto>? produtos;
    private ProdutoDto novoProduto = new();

    private bool carregandoLista;
    private bool salvando;
    private bool offline;
    private DateTime? dataCache;

    private string erroLista = string.Empty;
    private string erroSalvar = string.Empty;
    private string sucessoSalvar = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        carregandoLista = true;
        erroLista = string.Empty;

        try
        {
            produtos = await Http.GetFromJsonAsync<List<ProdutoDto>>("api/produtos") ?? [];
            offline = false;
            await SalvarCache(produtos);
        }
        catch (Exception ex)
        {
            // Cache offline simples: se a API falhar, mostra a última lista que deu certo.
            var cache = await LerCache();
            if (cache is not null)
            {
                produtos = cache.Produtos;
                dataCache = cache.SalvoEm;
                offline = true;
            }
            else
            {
                produtos = null;
                erroLista = $"Não foi possível carregar os produtos ({ex.Message}).";
            }
        }
        finally
        {
            carregandoLista = false;
        }
    }

    private async Task CriarProduto()
    {
        salvando = true;
        erroSalvar = string.Empty;
        sucessoSalvar = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/produtos", novoProduto);
            if (response.IsSuccessStatusCode)
            {
                novoProduto = new();
                sucessoSalvar = "Produto criado com sucesso.";
                await CarregarProdutos();
            }
            else
            {
                erroSalvar = await LerErro(response);
            }
        }
        catch (HttpRequestException)
        {
            erroSalvar = "Não foi possível falar com a API. Verifique a conexão e tente novamente.";
        }
        finally
        {
            salvando = false;
        }
    }

    // Traduz a resposta de erro da API (ProblemDetails com "errors") em uma mensagem legível.
    private static async Task<string> LerErro(HttpResponseMessage response)
    {
        try
        {
            using var doc = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("errors", out var errors))
            {
                var mensagens = errors.EnumerateObject()
                    .SelectMany(e => e.Value.EnumerateArray().Select(m => m.GetString()))
                    .Where(m => !string.IsNullOrWhiteSpace(m));
                var texto = string.Join(" ", mensagens);
                if (texto.Length > 0)
                    return texto;
            }
        }
        catch (JsonException)
        {
        }

        return $"A API recusou o produto ({(int)response.StatusCode} {response.ReasonPhrase}).";
    }

    private async Task SalvarCache(List<ProdutoDto> lista)
    {
        try
        {
            var json = JsonSerializer.Serialize(new ListaEmCache(DateTime.Now, lista));
            await JS.InvokeVoidAsync("localStorage.setItem", ChaveCache, json);
        }
        catch (JSException)
        {
            // localStorage indisponível (ex.: navegação privada): segue sem cache.
        }
    }

    private async Task<ListaEmCache?> LerCache()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ChaveCache);
            return json is null ? null : JsonSerializer.Deserialize<ListaEmCache>(json);
        }
        catch (Exception ex) when (ex is JSException or JsonException)
        {
            return null;
        }
    }

    private sealed record ListaEmCache(DateTime SalvoEm, List<ProdutoDto> Produtos);
}
