@page "/weather"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Weather</PageTitle>

<header class="page-header">
    <h1>Weather</h1>
    <p class="text-secondary mb-0">Exemplo do template: busca um arquivo JSON do próprio site.</p>
</header>

<div class="card">
    @if (forecasts == null)
    {
        <div class="card-body d-flex align-items-center" role="status">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Carregando...</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th class="text-end" aria-label="Temperatura em Celsius">Temp. (C)</th>
                        <th class="text-end" aria-label="Temperatura em Fahrenheit">Temp. (F)</th>
                        <th>Resumo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forecast in forecasts)
                    {
                        <tr>
                            <td>@forecast.Date.ToShortDateString()</td>
                            <td class="text-end">@forecast.TemperatureC</td>
                            <td class="text-end">@forecast.TemperatureF</td>
                            <td>@forecast.Summary</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        // O HttpClient aponta para a API (Program.cs); o arquivo de exemplo está no próprio site do WASM.
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>(Navigation.BaseUri + "sample-data/weather.json");
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }

        public int TemperatureC { get; set; }

        public string? Summary { get; set; }

        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
