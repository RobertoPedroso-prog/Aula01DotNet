@model Aula02.Web.Models.HomeViewModel

@{
    ViewData["Title"] = "Lista de Usuários e Produtos";
}

<h2>Usuários Ativos</h2>

<ul>
    @foreach (var usuario in Model.Usuarios)
    {
        <li><strong>ID:</strong> @usuario.Id - <strong>Nome:</strong> @usuario.Nome</li>
    }
</ul>

<h2>Produtos Ativos</h2>

<ul>
    @foreach (var produto in Model.Produtos)
    {
        <li><strong>ID:</strong> @produto.Id - <strong>Nome:</strong> @produto.Nome - <strong>Preço:</strong> @produto.Preco.ToString("C")</li>
    }
</ul>

